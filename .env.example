# better auth
# Generate a value with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Base URL of the running app (http://localhost:3000 in development)
BETTER_AUTH_URL=http://localhost:3000

# vercel neon
# Pooled connection, used by the app at runtime
DATABASE_URL=
# Direct (unpooled) connection, used by drizzle-kit for migrations
DATABASE_URL_UNPOOLED=
