# better auth
# Generate a value with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Base URL of the running app. Also used to build invitation links, so it must
# be the public URL in production (http://localhost:3000 in development)
BETTER_AUTH_URL=http://localhost:3000

# vercel neon
# These are two connections to ONE database — copy both from the same Neon
# endpoint. The hostnames must differ only by "-pooler". Pointing them at
# different databases fails silently: migrations apply cleanly to the one the
# app never opens. drizzle.config.ts refuses to run when they disagree.
# Production and development are two separate databases: main deploys against
# production, every other branch and local development share the development
# one. Production is migrated by its own deploy (scripts/migrate-on-deploy.ts),
# so BOTH variables must be set in Vercel's Production environment — the app
# reads the pooled one, drizzle-kit migrates over the direct one.
# Pooled connection, used by the app at runtime
DATABASE_URL=
# Direct (unpooled) connection, used by drizzle-kit for migrations
DATABASE_URL_UNPOOLED=

# sign-up
# Sign-up is invite only unless this is exactly "true". The very first account
# in an empty database is always allowed through, so a fresh deployment can be
# set up.
ALLOW_PUBLIC_SIGNUP=false

# exchange rates
# Bearer token Vercel Cron presents to /api/cron/refresh-rates. Without it the
# endpoint refuses to run rather than sitting open. Generate like the auth
# secret: openssl rand -base64 32
# Rates are also fetched on demand, so a missing cron only means staler cache.
CRON_SECRET=

# resend (optional — invitations work without it, by copying the link)
RESEND_API_KEY=
# Must be an address on a domain verified in Resend. Resend refuses to send
# from anything else. "onboarding@resend.dev" needs no setup but only delivers
# to the Resend account's own address, so it cannot reach other people.
# Leave this empty and invitations still work — you just send the link yourself.
RESEND_FROM=
